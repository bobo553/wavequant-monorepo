 ## GENERAL CONFIGURATION
## "development" | "staging" | "production" | "test"
NODE_ENV=development

## H5 CONFIGURATION
H5_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

## API CONFIGURATION
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

## DB CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=monorepo_template
DB_USERNAME=admin
DB_PASSWORD=admin

## WAVEQUANT OPTIONAL INFRASTRUCTURE
WAVEQUANT_DATABASE_URL=mysql+pymysql://wavequant:replace-me@127.0.0.1:3306/wavequant?charset=utf8mb4
WAVEQUANT_REDIS_URL=redis://127.0.0.1:6380/0
WAVEQUANT_REDIS_PORT=6380
WAVEQUANT_REDIS_PREFIX=wavequant
WAVEQUANT_CACHE_TTL_SECONDS=300
# K线数据键不设TTL；以下配置限定容量与逻辑刷新，通用缓存TTL不适用于K线。
WAVEQUANT_KLINE_MAX_ENTRIES=2048
WAVEQUANT_KLINE_MAX_MIB=512
WAVEQUANT_KLINE_MAX_ITEM_MIB=16
WAVEQUANT_KLINE_INTRADAY_SECONDS=60
WAVEQUANT_KLINE_REFRESH_BATCH=16
# Rust 在线行情默认调用真实 AKShare SDK；留空行注释时自动定位本项目 core 虚拟环境。
# WAVEQUANT_AKSHARE_PYTHON=C:/absolute/path/to/venv/Scripts/python.exe
