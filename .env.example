 ## GENERAL CONFIGURATION
## "development" | "staging" | "production" | "test"
NODE_ENV=development

## H5 CONFIGURATION
H5_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

## API CONFIGURATION
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

## DB CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=monorepo_template
DB_USERNAME=admin
DB_PASSWORD=admin

## WAVEQUANT OPTIONAL INFRASTRUCTURE
WAVEQUANT_DATABASE_URL=mysql+pymysql://wavequant:replace-me@127.0.0.1:3306/wavequant?charset=utf8mb4
WAVEQUANT_REDIS_URL=redis://127.0.0.1:6379/0
WAVEQUANT_REDIS_PREFIX=wavequant
WAVEQUANT_CACHE_TTL_SECONDS=300
