{
    "name": "wavequant-web",
    "version": "0.4.0",
    "description": "WaveQuant panoramic market dashboard and browser research workbench",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node scripts/prepare-legacy.mjs",
        "dev": "node scripts/dev.mjs",
        "dev:web": "next dev --turbopack --port 3003",
        "prebuild": "node scripts/prepare-legacy.mjs",
        "build": "next build --turbopack",
        "start": "next start --port 3003",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier:fix": "prettier --write src tests scripts package.json README.md progress.md eslint.config.mjs next.config.ts playwright.config.ts postcss.config.mjs vitest.config.ts vitest.setup.ts tsconfig.json",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run && node --test tests/*.test.mjs",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:watch": "vitest",
        "pretest:e2e": "playwright install chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm test:unit && pnpm test:e2e"
    },
    "dependencies": {
        "@repo/contracts": "workspace:*",
        "@repo/design-system-web": "workspace:*",
        "@tabler/icons-react": "^3.44.0",
        "echarts": "^6.1.0",
        "lightweight-charts": "5.2.1",
        "next": "^16.2.6",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tldraw": "^5.4.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@repo/eslint": "workspace:*",
        "@repo/playwright": "workspace:*",
        "@repo/typescript": "workspace:*",
        "@repo/vitest": "workspace:*",
        "@tailwindcss/postcss": "^4.3.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.8.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.2.1",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.7"
    }
}
