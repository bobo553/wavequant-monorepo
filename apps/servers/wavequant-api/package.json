{
    "name": "wavequant-api",
    "version": "0.4.0",
    "description": "Loopback HTTP adapter for the WaveQuant research workbench",
    "private": true,
    "type": "module",
    "scripts": {
        "python": "node scripts/run-python.mjs",
        "dashboard": "node scripts/run-python.mjs -m wavequant_api.cli --port 8765",
        "infra:check": "node scripts/run-python.mjs -m wavequant_api.cli --check-infrastructure",
        "infra:init": "node scripts/run-python.mjs -m wavequant_api.cli --init-database",
        "infra:index": "node scripts/run-python.mjs -m wavequant_api.cli --index-runs",
        "structures:refresh": "node scripts/run-python.mjs -m wavequant_api.cli --refresh-structures --tdx-root D:/TDX",
        "structures:watch": "node scripts/run-python.mjs -m wavequant_api.cli --watch-structures --tdx-root D:/TDX",
        "signals:refresh": "node scripts/run-python.mjs -m wavequant_api.cli --refresh-signals --tdx-root D:/TDX",
        "signals:watch": "node scripts/run-python.mjs -m wavequant_api.cli --watch-signals --tdx-root D:/TDX",
        "timeframes:refresh": "node scripts/run-python.mjs -m wavequant_api.cli --refresh-timeframes --tdx-root D:/TDX",
        "timeframes:watch": "node scripts/run-python.mjs -m wavequant_api.cli --watch-timeframes --tdx-root D:/TDX",
        "structures:watch:akshare": "node scripts/run-python.mjs -m wavequant_api.cli --watch-signals --signal-family structure --signal-source akshare --tdx-root D:/TDX",
        "infra:up": "docker compose --env-file .env.infrastructure -f compose.yaml up -d",
        "infra:down": "docker compose --env-file .env.infrastructure -f compose.yaml down",
        "build": "node scripts/run-python.mjs -m build --no-isolation",
        "lint": "node scripts/run-python.mjs -m ruff check src tests",
        "lint:fix": "node scripts/run-python.mjs -m ruff check --fix src tests",
        "prettier:fix": "prettier --write package.json progress.md README.md",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "node scripts/run-python.mjs -m mypy --strict src/wavequant_api/infrastructure src/wavequant_api/application src/wavequant_api/cli.py",
        "test:unit": "node scripts/run-python.mjs -m pytest",
        "test:integration": "node scripts/run-python.mjs -m pytest -m integration",
        "test:all": "pnpm test:unit"
    },
    "dependencies": {
        "@wavequant/core": "workspace:*",
        "wavequant-web": "workspace:*"
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    }
}
