WAVEQUANT_MYSQL_DATABASE=wavequant
WAVEQUANT_MYSQL_USER=wavequant
WAVEQUANT_MYSQL_PASSWORD=replace-with-a-local-password
WAVEQUANT_MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
WAVEQUANT_MYSQL_PORT=3306
WAVEQUANT_REDIS_PORT=6379

WAVEQUANT_DATABASE_URL=mysql+pymysql://wavequant:replace-with-a-local-password@127.0.0.1:3306/wavequant?charset=utf8mb4
WAVEQUANT_REDIS_URL=redis://127.0.0.1:6379/0
WAVEQUANT_REDIS_PREFIX=wavequant
WAVEQUANT_CACHE_TTL_SECONDS=300
WAVEQUANT_DB_POOL_SIZE=5
WAVEQUANT_DB_CONNECT_TIMEOUT_SECONDS=3
WAVEQUANT_REDIS_CONNECT_TIMEOUT_SECONDS=2

# 推荐的生产数据库替代配置（需安装项目的 postgres extra）：
# WAVEQUANT_DATABASE_URL=postgresql+psycopg://wavequant:replace-me@127.0.0.1:5432/wavequant
