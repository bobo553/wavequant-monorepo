{
    "name": "@wavequant/core",
    "version": "0.4.0",
    "description": "Framework-independent WaveQuant Python research core",
    "private": true,
    "type": "module",
    "scripts": {
        "python": "node scripts/run-python.mjs",
        "build": "node scripts/run-python.mjs -m build --no-isolation",
        "prettier:fix": "prettier --write package.json progress.md README.md",
        "format": "pnpm prettier:fix",
        "typecheck": "node scripts/run-python.mjs -m mypy --strict src/wavequant/infrastructure/filesystem/project_paths.py src/wavequant/infrastructure/market_data/akshare.py src/wavequant/interfaces/charts/akshare_browser.py src/wavequant/interfaces/charts/market_data_repository.py",
        "test:unit": "node scripts/run-python.mjs -m pytest",
        "test:all": "pnpm test:unit"
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    }
}
